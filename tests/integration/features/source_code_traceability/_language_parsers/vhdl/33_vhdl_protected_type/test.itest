# @relation(SDOC-SRS-209, SDOC-SRS-137, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/file.vhd.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#3#4">
CHECK-HTML: file.vhd, <i>lines: 3-4</i>, function p.counter_t.incr()
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#12#16">
CHECK-HTML: file.vhd, <i>lines: 12-16</i>, function p.counter_t.incr()
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-2#12#16">
CHECK-HTML: file.vhd, <i>lines: 12-16</i>, function p.counter_t.incr()
