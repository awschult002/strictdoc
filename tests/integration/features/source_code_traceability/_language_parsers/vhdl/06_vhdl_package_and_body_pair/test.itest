# @relation(SDOC-SRS-209, SDOC-SRS-137, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/file_pkg.vhd.html"
RUN: %check_exists --file "%T/html/_source_files/file_body.vhd.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/file_body.vhd.html#REQ-1#2#5">
CHECK-HTML: file_body.vhd, <i>lines: 2-5</i>, function hello.hello_world_1()
CHECK-HTML: <a{{.*}}href="../_source_files/file_pkg.vhd.html#REQ-1#2#3">
CHECK-HTML: file_pkg.vhd, <i>lines: 2-3</i>, function hello.hello_world_1()
CHECK-HTML: <a{{.*}}href="../_source_files/file_body.vhd.html#REQ-2#7#10">
CHECK-HTML: file_body.vhd, <i>lines: 7-10</i>, function hello.hello_world_2()
CHECK-HTML: <a{{.*}}href="../_source_files/file_pkg.vhd.html#REQ-2#5#6">
CHECK-HTML: file_pkg.vhd, <i>lines: 5-6</i>, function hello.hello_world_2()
