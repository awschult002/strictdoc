# @relation(SDOC-SRS-209, SDOC-SRS-137, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/file.vhd.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#2#8">
CHECK-HTML: file.vhd, <i>lines: 2-8</i>, function hello.hello_world()
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#16#20">
CHECK-HTML: file.vhd, <i>lines: 16-20</i>, function hello.hello_world_3()
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#22#27">
CHECK-HTML: file.vhd, <i>lines: 22-27</i>, function hello.hello_world_4()
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-2#10#14">
CHECK-HTML: file.vhd, <i>lines: 10-14</i>, function hello.answer()
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-2#16#20">
CHECK-HTML: file.vhd, <i>lines: 16-20</i>, function hello.hello_world_3()
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-2#22#27">
CHECK-HTML: file.vhd, <i>lines: 22-27</i>, function hello.hello_world_4()
