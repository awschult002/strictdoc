# @relation(SDOC-SRS-209, SDOC-SRS-145, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/file.vhd.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#2#7">
CHECK-HTML: file.vhd, <i>lines: 2-7</i>, function hello.hello_world()
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#14#17">
CHECK-HTML: file.vhd, <i>lines: 14-17</i>, function hello.hello_world_3()
