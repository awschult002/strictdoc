# @relation(SDOC-SRS-209, SDOC-SRS-137, SDOC-SRS-145, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/file.vhd.html"
RUN: %check_exists --file "%T/html/_source_files/file2.vhd.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#1#31">
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#1#31">
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#4#9">
CHECK-HTML: <a{{.*}}href="../_source_files/file.vhd.html#REQ-1#26#27">
CHECK-HTML: <a{{.*}}href="../_source_files/file2.vhd.html#REQ-1#1#6">

RUN: %cat %T/html/_source_files/file.vhd.html | filecheck %s --dump-input=fail --check-prefix CHECK-FILE
CHECK-FILE: 1 - 31 | entire file
CHECK-FILE: 4 - 9 | function hello.foo()
CHECK-FILE: 11 - 16 | range
CHECK-FILE: 20 - 30 | function hello.long_function_name()
CHECK-FILE: 24 - 28 | range
CHECK-FILE: 26 - 27 | line

RUN: %cat %T/html/source_coverage.html | filecheck %s --dump-input=fail --check-prefix CHECK-SOURCE-COVERAGE
CHECK-SOURCE-COVERAGE: 100.0
