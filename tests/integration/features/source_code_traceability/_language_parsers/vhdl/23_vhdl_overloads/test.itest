# @relation(SDOC-SRS-209, SDOC-SRS-137, scope=file)

RUN: %strictdoc export %S --output-dir %T | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %check_exists --file "%T/html/_source_files/pkg.vhd.html"
RUN: %check_exists --file --invert "%T/html/_source_files/pkg_body.vhd.html"

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-HTML
CHECK-HTML: <a{{.*}}href="../_source_files/pkg.vhd.html#REQ-1#2#3">
CHECK-HTML: pkg.vhd, <i>lines: 2-3</i>, function pkg.bar()
CHECK-HTML: <a{{.*}}href="../_source_files/pkg.vhd.html#REQ-2#5#6">
CHECK-HTML: pkg.vhd, <i>lines: 5-6</i>, function pkg.bar()

RUN: %cat %T/html/%THIS_TEST_FOLDER/input.html | filecheck %s --dump-input=fail --check-prefix CHECK-NEG
CHECK-NEG-NOT: pkg_body.vhd.html
