#
# @relation(SDOC-LLR-221, scope=file)
#

REQUIRES: TKINTER_AVAILABLE

RUN: rm -rf %T/project
RUN: %mkdir %T/project
RUN: %cp %S/input.sdoc %T/project/input.sdoc
RUN: %launcher_probe -- %strictdoc launcher --no-window --no-browser --project %T/project --port 5361 | filecheck %s --dump-input=fail
CHECK: PROBE: server ready on 127.0.0.1
CHECK: PROBE: GET / returned 200
CHECK: PROBE: start page lists the requirements
CHECK: PROBE: launcher stopped
CHECK: PROBE: server port is free
