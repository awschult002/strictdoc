#
# @relation(SDOC-LLR-221, scope=file)
#

REQUIRES: TKINTER_AVAILABLE

RUN: rm -rf %T/project
RUN: %mkdir %T/project
RUN: %cp %S/input.sdoc %T/project/input.sdoc
RUN: %launcher_probe --occupy-port 5345 -- %strictdoc launcher --no-window --no-browser --project %T/project --port 5345 | filecheck %s --dump-input=fail
CHECK: PROBE: occupied port 5345
CHECK: PROBE: server ready on 127.0.0.1
CHECK: PROBE: server uses a different port
CHECK: PROBE: GET / returned 200
CHECK: PROBE: launcher stopped
CHECK: PROBE: server port is free
