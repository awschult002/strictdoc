{#
  Stable link copy button — handled by the delegated document-level
  listener in copy_to_clipboard.js (.copy_stable_link-button). data-path is
  a relative path resolved to a full URL at click time. The script switches
  the icon to the "done" icon as feedback.

  Requires: path
#}
{%- if path is defined -%}
  <div class="copy_stable_link-button" data-path="{{ path }}" title="Click to copy a stable node link to the clipboard">
    <svg class="svg_icon"><use href="#sdoc-icon-link"/></svg>
  </div>
{%- endif -%}
