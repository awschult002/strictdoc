{#
  Anchor copy button — handled by the delegated document-level listener in
  copy_to_clipboard.js (.anchor_button). data-anchor-id is the value to
  copy. The script switches the icons to the "done" icon as feedback.

  Requires: anchor_button_text
#}
<div class="anchor_button" title="Click to copy" data-testid="section-anchor-button" data-anchor-id="{{ anchor_button_text }}">
  <span class="svg_icon_not_hover_visible"><svg class="svg_icon"><use href="#sdoc-icon-anchor"/></svg></span>
  <span class="svg_icon_hover_visible"><svg class="svg_icon"><use href="#sdoc-icon-copy"/></svg></span>
  <div class="copy_to_clipboard-cover"></div>
  <span class="anchor_button_text">{{ anchor_button_text }}</span>
</div>
