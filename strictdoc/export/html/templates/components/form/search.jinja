{% assert view_object.error is defined %}

<sdoc-form search
 {% if (view_object.error is none) and (view_object.search_results|length > 0) %}success{% endif %}
>

  <form
    action="/search"
    method="GET"
  >
      <input
        type="text"
        value="{{ view_object.search_value }}"
        placeholder="Enter search query here"
        id="q"
        name="q"
      />
      {% include "components/button/search.jinja" %}
  </form>

{%- if view_object.saved_queries|length > 0 %}
  <form
    action="/search"
    method="GET"
    data-testid="saved-queries-form"
  >
    <label for="saved_query">Saved queries</label>
    <select
      id="saved_query"
      name="q"
      data-testid="saved-queries-select"
      onchange="this.form.requestSubmit()"
    >
      <option value="" disabled{% if view_object.get_current_saved_query() is none %} selected{% endif %}>Select a saved query</option>
      {%- for saved_query_ in view_object.saved_queries %}
      <option
        value="{{ saved_query_.value }}"
        title="{{ saved_query_.value }}"
        {% if view_object.get_current_saved_query() is sameas saved_query_ %}selected{% endif %}
      >{{ saved_query_.title }}</option>
      {%- endfor %}
    </select>
  </form>
{%- endif %}

{%- if view_object.search_value|length > 0 -%}
  {%- if view_object.error is none -%}
    {%- if view_object.search_results|length == 0 -%}
      <div class="sdoc-form-success">Nothing matching the query was found.</div>
    {%- elif view_object.search_results|length > 0 -%}
      <div class="sdoc-form-success">Found <b>{{ view_object.search_results|length }}</b> results.</div>
    {%- endif -%}
  {%- else -%}
      <div class="sdoc-form-error">{{ view_object.error }}</div>
  {%- endif -%}
  <a class="sdoc-form-reset" href="{{ view_object.render_url('search') }}">Clear query</a>
{%- endif -%}
</sdoc-form>
