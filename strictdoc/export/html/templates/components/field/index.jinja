{#
  Field with optional copy button — handled by the delegated document-level
  listener in copy_to_clipboard.js.

  To enable the copy button, declare before including this template:
    {% set copy_to_clipboard = True %}

  When enabled, the listener reads the text content of sdoc-field-content at click time.

  Expected structure (used by copy_to_clipboard.js):
    .copy_to_clipboard-button  — the copy button
    .copy_to_clipboard-cover   — orange fade animation
  The button's icon is switched to the "done" icon by the script.
#}

{%- if copy_to_clipboard is defined -%}
<sdoc-field>
  <sdoc-field-content>
    <sdoc-autogen>{{ field_content }}</sdoc-autogen>
  </sdoc-field-content>
  <sdoc-field-service>

    <div class="copy_to_clipboard">
      <div class="copy_to_clipboard-cover">
        <div title="Click to copy" class="copy_to_clipboard-button action_button">
          <svg class="svg_icon"><use href="#sdoc-icon-copy"/></svg>
        </div>
      </div>
    </div>

  </sdoc-field-service>
</sdoc-field>
{%- else -%}
<sdoc-autogen>{{ field_content }}</sdoc-autogen>
{%- endif -%}
